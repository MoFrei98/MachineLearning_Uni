   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 🌸 Flower Classification - ML Pipeline\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook demonstrates how to train and evaluate machine learning models for iris flower classification.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Goal:** Classify iris flowers into 3 species based on 4 features (sepal length/width, petal length/width).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Setup: Install Dependencies\\n\",\n",
    "    \"\\n\",\n",
    "    \"Run this cell once to install all required packages from requirements.txt:\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import subprocess\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Install the project in editable mode\\n\",\n",
    "    \"subprocess.check_call([sys.executable, \\\"-m\\\", \\\"pip\\\", \\\"install\\\", \\\"-e\\\", \\\".\\\"])\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Import Required Libraries\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Standard libraries\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ML Pipeline components\\n\",\n",
    "    \"from ml.dataset import Dataset\\n\",\n",
    "    \"from ml.models.model_factory import ModelFactory\\n\",\n",
    "    \"from ml.trainer import Trainer\\n\",\n",
    "    \"from ml.metrics.accuracy import Accuracy\\n\",\n",
    "    \"from ml.metrics.confusion_matrix import ConfusionMatrix\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Set style\\n\",\n",
    "    \"sns.set_style(\\\"whitegrid\\\")\\n\",\n",
    "    \"plt.rcParams['figure.figsize'] = (10, 6)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"✓ All libraries imported successfully!\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Load the Dataset\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Create dataset with custom test size\\n\",\n",
    "    \"test_size = 0.3\\n\",\n",
    "    \"random_state = 42\\n\",\n",
    "    \"\\n\",\n",
    "    \"dataset = Dataset(test_size=test_size, random_state=random_state)\\n\",\n",
    "    \"dataset.load_data()\\n\",\n",
    "    \"\\n\",\n",
    "    \"x_train, y_train = dataset.get_train_data()\\n\",\n",
    "    \"x_test, y_test = dataset.get_test_data()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"✓ Dataset loaded:\\\")\\n\",\n",
    "    \"print(f\\\"  Training samples: {len(x_train)}\\\")\\n\",\n",
    "    \"print(f\\\"  Testing samples: {len(x_test)}\\\")\\n\",\n",
    "    \"print(f\\\"  Features: {list(x_train.columns)}\\\")\\n\",\n",
    "    \"print(f\\\"  Classes: {sorted(y_train.unique())}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Explore the Data\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Display first few samples\\n\",\n",
    "    \"print(\\\"Training Data Sample:\\\")\\n\",\n",
    "    \"print(x_train.head())\\n\",\n",
    "    \"print(f\\\"\\\\nTarget Distribution:\\\\n{y_train.value_counts()}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Visualize feature distributions\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 2, figsize=(12, 10))\\n\",\n",
    "    \"features = x_train.columns\\n\",\n",
    "    \"\\n\",\n",
    "    \"for idx, feature in enumerate(features):\\n\",\n",
    "    \"    ax = axes[idx // 2, idx % 2]\\n\",\n",
    "    \"    for species in y_train.unique():\\n\",\n",
    "    \"        mask = y_train == species\\n\",\n",
    "    \"        ax.hist(x_train[mask][feature], alpha=0.5, label=species)\\n\",\n",
    "    \"    ax.set_xlabel(feature)\\n\",\n",
    "    \"    ax.set_ylabel(\\\"Frequency\\\")\\n\",\n",
    "    \"    ax.set_title(f\\\"Distribution of {feature}\\\")\\n\",\n",
    "    \"    ax.legend()\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Train Different Models\\n\",\n",
    "    \"\\n\",\n",
    "    \"Let's compare all 8 available models:\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# List all available models\\n\",\n",
    "    \"available_models = [\\n\",\n",
    "    \"    \\\"svm_linear\\\",\\n\",\n",
    "    \"    \\\"svm_rbf\\\",\\n\",\n",
    "    \"    \\\"svm_poly\\\",\\n\",\n",
    "    \"    \\\"svm_sigmoid\\\",\\n\",\n",
    "    \"    \\\"decision_tree\\\",\\n\",\n",
    "    \"    \\\"knn\\\",\\n\",\n",
    "    \"    \\\"random_forest\\\",\\n\",\n",
    "    \"    \\\"lda\\\"\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Train all models and store results\\n\",\n",
    "    \"results = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"for model_name in available_models:\\n\",\n",
    "    \"    print(f\\\"\\\\nTraining {model_name}...\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Create model from factory\\n\",\n",
    "    \"    model = ModelFactory.get_model(model_name, input_shape=4, output_shape=3)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Initialize metrics\\n\",\n",
    "    \"    metrics = [Accuracy()]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Train\\n\",\n",
    "    \"    trainer = Trainer(model=model, dataset=dataset, metrics_list=metrics, epochs=1)\\n\",\n",
    "    \"    trainer.train()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Evaluate\\n\",\n",
    "    \"    evaluation = trainer.evaluate()\\n\",\n",
    "    \"    accuracy = evaluation['Accuracy']\\n\",\n",
    "    \"    results[model_name] = accuracy\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    print(f\\\"  ✓ Accuracy: {accuracy:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\"*50)\\n\",\n",
    "    \"print(\\\"Training completed for all models!\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Compare Model Performance\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Sort results by accuracy\\n\",\n",
    "    \"sorted_results = dict(sorted(results.items(), key=lambda x: x[1], reverse=True))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Display results\\n\",\n",
    "    \"print(\\\"\\\\n--- Model Rankings ---\\\")\\n\",\n",
    "    \"for rank, (model_name, accuracy) in enumerate(sorted_results.items(), 1):\\n\",\n",
    "    \"    print(f\\\"{rank}. {model_name:20} - Accuracy: {accuracy:.4f} ({accuracy*100:.2f}%)\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Visualize model comparison\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(12, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"models = list(sorted_results.keys())\\n\",\n",
    "    \"accuracies = list(sorted_results.values())\\n\",\n",
    "    \"\\n\",\n",
    "    \"bars = ax.barh(models, accuracies, color='steelblue')\\n\",\n",
    "    \"ax.set_xlabel('Accuracy', fontsize=12)\\n\",\n",
    "    \"ax.set_title('Model Performance Comparison', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"ax.set_xlim([0, 1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add value labels on bars\\n\",\n",
    "    \"for bar, accuracy in zip(bars, accuracies):\\n\",\n",
    "    \"    ax.text(accuracy + 0.01, bar.get_y() + bar.get_height()/2, \\n\",\n",
    "    \"            f'{accuracy:.4f}', va='center', fontsize=10)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 6. Detailed Analysis of Best Model\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Get the best model\\n\",\n",
    "    \"best_model_name = list(sorted_results.keys())[0]\\n\",\n",
    "    \"print(f\\\"Best Model: {best_model_name}\\\")\\n\",\n",
    "    \"print(f\\\"Accuracy: {sorted_results[best_model_name]:.4f}\\\\n\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Retrain best model with confusion matrix\\n\",\n",
    "    \"best_model = ModelFactory.get_model(best_model_name, input_shape=4, output_shape=3)\\n\",\n",
    "    \"metrics = [Accuracy(), ConfusionMatrix()]\\n\",\n",
    "    \"\\n\",\n",
    "    \"trainer = Trainer(model=best_model, dataset=dataset, metrics_list=metrics, epochs=1)\\n\",\n",
    "    \"trainer.train()\\n\",\n",
    "    \"\\n\",\n",
    "    \"results_best = trainer.evaluate()\\n\",\n",
    "    \"print(results_best['Confusion Matrix'])\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 7. Make Predictions on New Data\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Get predictions on test data\\n\",\n",
    "    \"x_test_data, y_test_data = dataset.get_test_data()\\n\",\n",
    "    \"predictions = best_model.predict(x_test_data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Display some predictions\\n\",\n",
    "    \"sample_indices = np.random.choice(len(predictions), 10, replace=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"prediction_df = pd.DataFrame({\\n\",\n",
    "    \"    'True Label': y_test_data.iloc[sample_indices].values,\\n\",\n",
    "    \"    'Prediction': predictions[sample_indices],\\n\",\n",
    "    \"    'Correct': y_test_data.iloc[sample_indices].values == predictions[sample_indices]\\n\",\n",
    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Sample Predictions:\\\")\\n\",\n",
    "    \"print(prediction_df.to_string())\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"✓ Successfully demonstrated the ML Pipeline!\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Key Takeaways:**\\n\",\n",
    "    \"- Loaded and explored the Iris dataset\\n\",\n",
    "    \"- Trained 8 different ML models\\n\",\n",
    "    \"- Compared model performance\\n\",\n",
    "    \"- Evaluated the best model with detailed metrics\\n\",\n",
    "    \"- Made predictions on new data\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Next Steps:**\\n\",\n",
    "    \"- Experiment with hyperparameters\\n\",\n",
    "    \"- Try feature scaling or normalization\\n\",\n",
    "    \"- Implement cross-validation\\n\",\n",
    "    \"- Create an ensemble of multiple models\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
